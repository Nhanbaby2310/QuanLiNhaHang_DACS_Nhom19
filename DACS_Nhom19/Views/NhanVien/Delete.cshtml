@model DACS_Nhom19.Models.NhanVien
@{
    ViewData["Title"] = "Xóa nhân viên";
}

<div class="page-header">
    <div>
        <h2 class="page-title text-danger"><i class="bi bi-trash"></i> Xóa nhân viên</h2>
    </div>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill"></i> Bạn có chắc muốn xóa nhân viên này không?
    <br><small>Nếu nhân viên đã có phân công hoặc đăng ký ca, hệ thống sẽ chặn xóa.</small>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã nhân viên</dt><dd class="col-sm-9">@Model.MaNhanVienCode</dd>
            <dt class="col-sm-3">Họ tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
            <dt class="col-sm-3">Chức vụ</dt><dd class="col-sm-9">@Model.ChucVu</dd>
            <dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.SoDienThoai</dd>
            <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaNhanVien" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
