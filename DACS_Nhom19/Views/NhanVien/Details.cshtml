@model DACS_Nhom19.Models.NhanVien
@{
    ViewData["Title"] = "Chi tiết nhân viên";
    var stClass = Model.TrangThai switch
    {
        "Đang làm" => "bg-active",
        "Nghỉ phép" => "bg-pending",
        "Nghỉ việc" => "bg-inactive",
        _ => "bg-inactive"
    };
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-person-vcard"></i> Chi tiết nhân viên</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.MaNhanVien" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><i class="bi bi-person-vcard"></i> Thông tin cá nhân</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã nhân viên</dt>
                    <dd class="col-sm-8"><code>@Model.MaNhanVienCode</code></dd>
                    <dt class="col-sm-4">Họ tên</dt>
                    <dd class="col-sm-8"><strong>@Model.HoTen</strong></dd>
                    <dt class="col-sm-4">Giới tính</dt>
                    <dd class="col-sm-8">@Model.GioiTinh</dd>
                    <dt class="col-sm-4">Ngày sinh</dt>
                    <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Số điện thoại</dt>
                    <dd class="col-sm-8">@Model.SoDienThoai</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Địa chỉ</dt>
                    <dd class="col-sm-8">@(Model.DiaChi ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-briefcase"></i> Công việc</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Chức vụ</dt>
                    <dd class="col-sm-6">@Model.ChucVu</dd>
                    <dt class="col-sm-6">Loại NV</dt>
                    <dd class="col-sm-6">@Model.LoaiNhanVien</dd>
                    <dt class="col-sm-6">Vào làm</dt>
                    <dd class="col-sm-6">@Model.NgayVaoLam.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-6">Trạng thái</dt>
                    <dd class="col-sm-6"><span class="badge @stClass">@Model.TrangThai</span></dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-graph-up"></i> Định mức tuần</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Số ca tối thiểu</dt>
                    <dd class="col-sm-6">@Model.SoCaToiThieuTuan ca</dd>
                    <dt class="col-sm-6">Số giờ tối thiểu</dt>
                    <dd class="col-sm-6">@Model.SoGioToiThieuTuan giờ</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-key"></i> Tài khoản</div>
            <div class="card-body">
                @if (Model.MaTaiKhoanNavigation != null)
                {
                    <div><strong>@Model.MaTaiKhoanNavigation.TenDangNhap</strong></div>
                    <div class="text-muted small">@Model.MaTaiKhoanNavigation.HoTenHienThi</div>
                }
                else
                {
                    <div class="text-muted">Chưa gắn tài khoản</div>
                }
            </div>
        </div>
    </div>
</div>
