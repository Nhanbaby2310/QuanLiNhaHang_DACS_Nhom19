@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DACS_Nhom19</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DACS_Nhom19.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">DACS_Nhom19</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("Quản lý"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="NhanVien" asp-action="Index">Nhân viên</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="CaLam" asp-action="Index">Ca làm</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="PhanCongCa" asp-action="Index">Phân công ca</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("Quản lý") || User.IsInRole("Nhân viên"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="DangKyCa" asp-action="Index">Đăng ký ca</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("Quản lý"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ThongKe" asp-action="TongHop">Thống kê</a>
                                </li>
                            }

                            @if (User.IsInRole("Nhân viên"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ThongKe" asp-action="CaNhan">Thống kê của tôi</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Xin chào, @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link text-danger" style="text-decoration:none;">
                                        Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>