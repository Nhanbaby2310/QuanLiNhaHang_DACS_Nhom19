@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center p-4" style="max-width: 560px;">
        <div style="font-size: 5rem; color: var(--primary);">
            <i class="bi bi-bug-fill"></i>
        </div>
        <h3 class="mt-3 mb-2" style="color: var(--primary-dark);">Đã có lỗi xảy ra</h3>
        <p class="text-muted">Xin lỗi, yêu cầu của bạn không thể hoàn tất.</p>

        @if (Model.ShowRequestId)
        {
            <div class="alert alert-warning small"><strong>Request ID:</strong> <code>@Model.RequestId</code></div>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
            <i class="bi bi-house-door-fill"></i> Về trang chủ
        </a>
    </div>
</div>
