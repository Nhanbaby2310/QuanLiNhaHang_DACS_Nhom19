@model IEnumerable<DACS_Nhom19.Models.CaLam>

@{
    ViewData["Title"] = "Quản lý ca làm";
}

<div class="container mt-4">
    <h2 class="mb-4">Quản lý ca làm</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo mã ca, tên ca..." />
        </div>
        <div class="col-md-3">
            <select name="loaiCa" class="form-select">
                <option value="">-- Loại ca --</option>
                @if (ViewBag.LoaiCa == "Chuẩn")
                {
                    <option value="Chuẩn" selected>Chuẩn</option>
                }
                else
                {
                    <option value="Chuẩn">Chuẩn</option>
                }

                @if (ViewBag.LoaiCa == "Đặc biệt")
                {
                    <option value="Đặc biệt" selected>Đặc biệt</option>
                }
                else
                {
                    <option value="Đặc biệt">Đặc biệt</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">-- Trạng thái --</option>
                @if (ViewBag.TrangThai == "Hoạt động")
                {
                    <option value="Hoạt động" selected>Hoạt động</option>
                }
                else
                {
                    <option value="Hoạt động">Hoạt động</option>
                }

                @if (ViewBag.TrangThai == "Ngưng")
                {
                    <option value="Ngưng" selected>Ngưng</option>
                }
                else
                {
                    <option value="Ngưng">Ngưng</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
            <a asp-action="Index" class="btn btn-secondary w-100">Reset</a>
        </div>
    </form>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">+ Thêm ca làm</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã ca</th>
                    <th>Tên ca</th>
                    <th>Giờ bắt đầu</th>
                    <th>Giờ kết thúc</th>
                    <th>Loại ca</th>
                    <th>Tối thiểu</th>
                    <th>Tối đa</th>
                    <th>Trạng thái</th>
                    <th width="220">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaCaCode</td>
                        <td>@item.TenCa</td>
                        <td>@item.GioBatDau</td>
                        <td>@item.GioKetThuc</td>
                        <td>@item.LoaiCa</td>
                        <td>@item.SoLuongNhanVienToiThieu</td>
                        <td>@item.SoLuongNhanVienToiDa</td>
                        <td>@item.TrangThai</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.MaCa" class="btn btn-info btn-sm">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.MaCa" class="btn btn-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.MaCa" class="btn btn-danger btn-sm">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>