@model DACS_Nhom19.Models.CaLam
@{
    ViewData["Title"] = "Xóa ca làm";
}

<div class="page-header">
    <div>
        <h2 class="page-title text-danger"><i class="bi bi-trash"></i> Xóa ca làm</h2>
    </div>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill"></i> Bạn có chắc muốn xóa ca làm này không?
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã ca</dt><dd class="col-sm-9"><code>@Model.MaCaCode</code></dd>
            <dt class="col-sm-3">Tên ca</dt><dd class="col-sm-9">@Model.TenCa</dd>
            <dt class="col-sm-3">Giờ</dt><dd class="col-sm-9">@Model.GioBatDau.ToString("HH:mm") - @Model.GioKetThuc.ToString("HH:mm")</dd>
            <dt class="col-sm-3">Loại ca</dt><dd class="col-sm-9">@Model.LoaiCa</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaCa" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
