@model DACS_Nhom19.Models.CaLam

@{
    ViewData["Title"] = "Xóa ca làm";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">Xóa ca làm</h2>

    <div class="alert alert-warning">
        Bạn có chắc muốn xóa ca làm này không?
    </div>

    <table class="table table-bordered">
        <tr>
            <th width="250">Mã ca</th>
            <td>@Model.MaCaCode</td>
        </tr>
        <tr>
            <th>Tên ca</th>
            <td>@Model.TenCa</td>
        </tr>
        <tr>
            <th>Giờ bắt đầu</th>
            <td>@Model.GioBatDau</td>
        </tr>
        <tr>
            <th>Giờ kết thúc</th>
            <td>@Model.GioKetThuc</td>
        </tr>
        <tr>
            <th>Loại ca</th>
            <td>@Model.LoaiCa</td>
        </tr>
    </table>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaCa" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>