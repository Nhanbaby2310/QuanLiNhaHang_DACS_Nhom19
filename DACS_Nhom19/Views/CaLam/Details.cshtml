@model DACS_Nhom19.Models.CaLam
@{
    ViewData["Title"] = "Chi tiết ca làm";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-info-circle"></i> Chi tiết ca làm</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.MaCa" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã ca</dt>
            <dd class="col-sm-9"><code>@Model.MaCaCode</code></dd>
            <dt class="col-sm-3">Tên ca</dt>
            <dd class="col-sm-9"><strong>@Model.TenCa</strong></dd>
            <dt class="col-sm-3">Giờ bắt đầu</dt>
            <dd class="col-sm-9">@Model.GioBatDau.ToString("HH:mm")</dd>
            <dt class="col-sm-3">Giờ kết thúc</dt>
            <dd class="col-sm-9">@Model.GioKetThuc.ToString("HH:mm")</dd>
            <dt class="col-sm-3">Số giờ</dt>
            <dd class="col-sm-9">@(Model.SoGio?.ToString("0.##") ?? "-") giờ</dd>
            <dt class="col-sm-3">Loại ca</dt>
            <dd class="col-sm-9">@Model.LoaiCa</dd>
            <dt class="col-sm-3">Nhân viên tối thiểu</dt>
            <dd class="col-sm-9">@Model.SoLuongNhanVienToiThieu</dd>
            <dt class="col-sm-3">Nhân viên tối đa</dt>
            <dd class="col-sm-9">@Model.SoLuongNhanVienToiDa</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.TrangThai == "Hoạt động")
                {
                    <span class="badge bg-active">@Model.TrangThai</span>
                }
                else
                {
                    <span class="badge bg-inactive">@Model.TrangThai</span>
                }
            </dd>
            <dt class="col-sm-3">Ghi chú</dt>
            <dd class="col-sm-9">@(Model.GhiChu ?? "-")</dd>
        </dl>
    </div>
</div>
