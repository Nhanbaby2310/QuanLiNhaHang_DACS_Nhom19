@model DACS_Nhom19.Models.CaLam
@{
    ViewData["Title"] = "Cập nhật ca làm";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-pencil"></i> Cập nhật ca làm</h2>
        <p class="page-subtitle">Mã ca: <code>@Model.MaCaCode</code></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaCa" />
            <partial name="_Form" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Cập nhật</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
