@model DACS_Nhom19.Models.TaiKhoan
@{
    ViewData["Title"] = "Chi tiết tài khoản";
    var roleClass = Model.MaVaiTroNavigation?.TenVaiTro switch
    {
        "Admin" => "bg-rejected",
        "Quản lý" => "bg-pending",
        "Nhân viên" => "bg-assigned",
        _ => "bg-inactive"
    };
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-info-circle"></i> Chi tiết tài khoản</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Tên đăng nhập</dt>
            <dd class="col-sm-9"><code>@Model.TenDangNhap</code></dd>
            <dt class="col-sm-3">Họ tên hiển thị</dt>
            <dd class="col-sm-9"><strong>@Model.HoTenHienThi</strong></dd>
            <dt class="col-sm-3">Vai trò</dt>
            <dd class="col-sm-9"><span class="badge @roleClass">@Model.MaVaiTroNavigation?.TenVaiTro</span></dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.TrangThai == "Hoạt động")
                {
                    <span class="badge bg-active">@Model.TrangThai</span>
                }
                else
                {
                    <span class="badge bg-inactive">@Model.TrangThai</span>
                }
            </dd>
            <dt class="col-sm-3">Ngày tạo</dt>
            <dd class="col-sm-9">@Model.NgayTao.ToString("HH:mm dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Đăng nhập cuối</dt>
            <dd class="col-sm-9">@(Model.LanDangNhapCuoi?.ToString("HH:mm dd/MM/yyyy") ?? "-")</dd>
        </dl>
    </div>
</div>
