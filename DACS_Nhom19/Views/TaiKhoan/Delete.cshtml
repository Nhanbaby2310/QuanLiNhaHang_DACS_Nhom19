@model DACS_Nhom19.Models.TaiKhoan

@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">Xóa tài khoản</h2>

    <div class="alert alert-warning">
        Bạn có chắc muốn xóa tài khoản này không?
    </div>

    <table class="table table-bordered">
        <tr>
            <th width="250">Tên đăng nhập</th>
            <td>@Model.TenDangNhap</td>
        </tr>
        <tr>
            <th>Họ tên hiển thị</th>
            <td>@Model.HoTenHienThi</td>
        </tr>
        <tr>
            <th>Vai trò</th>
            <td>@Model.MaVaiTroNavigation?.TenVaiTro</td>
        </tr>
        <tr>
            <th>Trạng thái</th>
            <td>@Model.TrangThai</td>
        </tr>
    </table>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaTaiKhoan" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>