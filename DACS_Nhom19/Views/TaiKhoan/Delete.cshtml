@model DACS_Nhom19.Models.TaiKhoan
@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="page-header">
    <div>
        <h2 class="page-title text-danger"><i class="bi bi-trash"></i> Xóa tài khoản</h2>
    </div>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill"></i> Bạn có chắc muốn xóa tài khoản này không?
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Tên đăng nhập</dt><dd class="col-sm-9"><code>@Model.TenDangNhap</code></dd>
            <dt class="col-sm-3">Họ tên hiển thị</dt><dd class="col-sm-9">@Model.HoTenHienThi</dd>
            <dt class="col-sm-3">Vai trò</dt><dd class="col-sm-9">@Model.MaVaiTroNavigation?.TenVaiTro</dd>
            <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaTaiKhoan" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
