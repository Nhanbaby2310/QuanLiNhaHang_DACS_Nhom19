}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center p-4">
        <div style="font-size: 5rem; color: var(--primary);">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        <h3 class="mt-3 mb-2" style="color: var(--primary-dark);">Truy cập bị từ chối</h3>
        <p class="text-muted mb-4">Tài khoản của bạn không có quyền truy cập chức năng này.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door-fill"></i> Quay lại trang chủ
        </a>
    </div>
</div>
