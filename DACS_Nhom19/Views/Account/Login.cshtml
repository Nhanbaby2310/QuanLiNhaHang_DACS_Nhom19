@model DACS_Nhom19.ViewModels.LoginViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng nhập";
}

<<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo"><i class="bi bi-cup-hot-fill"></i></div>
            <h4>Hệ thống quản lý ca làm</h4>
            <div class="auth-subtitle">Nhà hàng • Đồ án cơ sở Nhóm 19</div>
        </div>

        <div class="auth-body">
            <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label">
                        <i class="bi bi-person-fill"></i> Tên đăng nhập
                    </label>
                    <input asp-for="TenDangNhap" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MatKhau" class="form-label">
                        <i class="bi bi-lock-fill"></i> Mật khẩu
                    </label>
                    <div class="input-group">
                        <input asp-for="MatKhau" type="password" class="form-control" autocomplete="current-password" id="matKhauInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()" tabindex="-1">
                            <i class="bi bi-eye" id="togglePwIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePassword() {
            const input = document.getElementById('matKhauInput');
            const icon = document.getElementById('togglePwIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
