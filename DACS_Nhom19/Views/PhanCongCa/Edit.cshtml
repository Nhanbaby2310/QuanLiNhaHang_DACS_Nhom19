@model DACS_Nhom19.Models.PhanCongCa
@{
    ViewData["Title"] = "Cập nhật phân công ca";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-pencil"></i> Cập nhật phân công ca</h2>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.MaPhanCong" method="post">
            <input type="hidden" asp-for="MaPhanCong" />
            <input type="hidden" asp-for="NgayTao" />
            <input type="hidden" asp-for="NguoiTao" />

            <partial name="_Form" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Cập nhật</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
