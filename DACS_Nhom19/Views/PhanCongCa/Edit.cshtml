@model DACS_Nhom19.Models.PhanCongCa




@{
    ViewData["Title"] = "Cập nhật phân công ca";
}

<div class="container mt-4">
    <h2 class="mb-4">Cập nhật phân công ca</h2>

    <form asp-action="Edit" asp-route-id="@Model.MaPhanCong" method="post">
        <input type="hidden" asp-for="MaPhanCong" />
        <input type="hidden" asp-for="NgayTao" />
        <input type="hidden" asp-for="NguoiTao" />

        <partial name="_Form" model="Model" />

        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}