@model IEnumerable<DACS_Nhom19.Models.DangKyCa>

@{
    ViewData["Title"] = "Đăng ký ca";
}

<div class="container mt-4">
    <h2 class="mb-4">Danh sách đăng ký ca</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo nhân viên / ca..." />
        </div>

        <div class="col-md-3">
            <input type="date" name="ngayLam" value="@ViewBag.NgayLam" class="form-control" />
        </div>

        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">-- Trạng thái --</option>
                <option value="Chờ duyệt">Chờ duyệt</option>
                <option value="Đã duyệt">Đã duyệt</option>
                <option value="Từ chối">Từ chối</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
            <a asp-action="Index" class="btn btn-secondary w-100">Reset</a>
        </div>
    </form>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">+ Đăng ký ca</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nhân viên</th>
                    <th>Ca làm</th>
                    <th>Ngày làm</th>
                    <th>Ngày đăng ký</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú</th>
                    <th width="300">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaNhanVienNavigation.MaNhanVienCode - @item.MaNhanVienNavigation.HoTen</td>
                        <td>@item.MaCaNavigation.TenCa</td>
                        <td>@item.NgayLam.ToString("dd/MM/yyyy")</td>
                        <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                        <td>@item.TrangThai</td>
                        <td>@item.GhiChu</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.MaDangKy" class="btn btn-info btn-sm">Chi tiết</a>

                            @if (User.IsInRole("Admin") || User.IsInRole("Quản lý"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.MaDangKy" class="btn btn-warning btn-sm">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.MaDangKy" class="btn btn-danger btn-sm">Xóa</a>

                                @if (item.TrangThai == "Chờ duyệt")
                                {
                                    <a asp-action="Duyet" asp-route-id="@item.MaDangKy" class="btn btn-success btn-sm">Duyệt</a>
                                    <a asp-action="TuChoi" asp-route-id="@item.MaDangKy" class="btn btn-secondary btn-sm">Từ chối</a>
                                }
                            }
                            else if (User.IsInRole("Nhân viên"))
                            {
                                @if (item.TrangThai == "Chờ duyệt")
                                {
                                    <a asp-action="Edit" asp-route-id="@item.MaDangKy" class="btn btn-warning btn-sm">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.MaDangKy" class="btn btn-danger btn-sm">Xóa</a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>