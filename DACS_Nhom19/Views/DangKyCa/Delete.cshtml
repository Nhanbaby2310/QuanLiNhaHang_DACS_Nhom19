@model DACS_Nhom19.Models.DangKyCa

@{
    ViewData["Title"] = "Xóa đăng ký ca";
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">Xóa đăng ký ca</h2>

    <div class="alert alert-warning">
        Bạn có chắc muốn xóa đăng ký ca này không?
    </div>

    <table class="table table-bordered">
        <tr>
            <th width="250">Nhân viên</th>
            <td>@Model.MaNhanVienNavigation.MaNhanVienCode - @Model.MaNhanVienNavigation.HoTen</td>
        </tr>
        <tr>
            <th>Ca làm</th>
            <td>@Model.MaCaNavigation.TenCa</td>
        </tr>
        <tr>
            <th>Ngày làm</th>
            <td>@Model.NgayLam.ToString("dd/MM/yyyy")</td>
        </tr>
        <tr>
            <th>Trạng thái</th>
            <td>@Model.TrangThai</td>
        </tr>
    </table>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaDangKy" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>