@model DACS_Nhom19.Models.DangKyCa
@{
    ViewData["Title"] = "Xóa đăng ký ca";
}

<div class="page-header">
    <div>
        <h2 class="page-title text-danger"><i class="bi bi-trash"></i> Xóa đăng ký ca</h2>
    </div>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill"></i> Bạn có chắc muốn xóa đăng ký này không?
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nhân viên</dt>
            <dd class="col-sm-9">@Model.MaNhanVienNavigation.HoTen (@Model.MaNhanVienNavigation.MaNhanVienCode)</dd>
            <dt class="col-sm-3">Ca làm</dt>
            <dd class="col-sm-9">@Model.MaCaNavigation.TenCa</dd>
            <dt class="col-sm-3">Ngày làm</dt>
            <dd class="col-sm-9">@Model.NgayLam.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@Model.TrangThai</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaDangKy" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
