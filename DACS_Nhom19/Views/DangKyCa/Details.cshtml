@model DACS_Nhom19.Models.DangKyCa
@{
    ViewData["Title"] = "Chi tiết đăng ký ca";

    var stClass = Model.TrangThai switch
    {
        "Chờ duyệt" => "bg-pending",
        "Đã duyệt" => "bg-approved",
        "Từ chối" => "bg-rejected",
        _ => "bg-inactive"
    };
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-info-circle"></i> Chi tiết đăng ký ca</h2>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nhân viên</dt>
            <dd class="col-sm-9"><strong>@Model.MaNhanVienNavigation.HoTen</strong> (@Model.MaNhanVienNavigation.MaNhanVienCode)</dd>

            <dt class="col-sm-3">Ca làm</dt>
            <dd class="col-sm-9">@Model.MaCaNavigation.TenCa</dd>

            <dt class="col-sm-3">Ngày làm</dt>
            <dd class="col-sm-9">@Model.NgayLam.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Đăng ký lúc</dt>
            <dd class="col-sm-9">@Model.NgayDangKy.ToString("HH:mm dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9"><span class="badge @stClass">@Model.TrangThai</span></dd>

            <dt class="col-sm-3">Ghi chú</dt>
            <dd class="col-sm-9">@(Model.GhiChu ?? "-")</dd>

            @if (Model.NguoiDuyet.HasValue)
            {
                <dt class="col-sm-3">Người duyệt</dt>
                <dd class="col-sm-9">@(Model.NguoiDuyetNavigation?.HoTenHienThi ?? "-")</dd>

                <dt class="col-sm-3">Thời điểm duyệt</dt>
                <dd class="col-sm-9">@(Model.NgayDuyet?.ToString("HH:mm dd/MM/yyyy") ?? "-")</dd>
            }
        </dl>
    </div>
</div>
